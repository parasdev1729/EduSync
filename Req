## 🗄️ MongoDB Schemas

### Student
```js
{
  enrollmentNo: String (unique),  // e.g. "2310992540"
  password: String,               // bcrypt hashed
  name: String,
  branch: String,
  semester: Number,
  section: String,
  email: String,
  phone: String,
  dob: Date,
  profilePic: String              // URL
}
```

### Attendance
```js
{
  studentId: ObjectId (ref: Student),
  session: String,                // e.g. "2024-25 (Even)"
  subject: String,
  totalClasses: Number,
  attended: Number
}
```

### Marks
```js
{
  studentId: ObjectId (ref: Student),
  session: String,
  subject: String,
  examType: String,              // "MST1" | "MST2" | "EndSem"
  marksObtained: Number,
  maxMarks: Number
}
```

### Circular
```js
{
  title: String,
  description: String,
  fileUrl: String,
  issuedBy: String,
  date: Date
}
```

### Activity
```js
{
  title: String,
  description: String,
  date: Date,
  venue: String,
  registrationLink: String
}
```

